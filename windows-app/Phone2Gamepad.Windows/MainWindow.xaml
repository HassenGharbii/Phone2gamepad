<Window x:Class="Phone2Gamepad.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Phone2Gamepad.Windows"
        Title="Phone2Gamepad" Width="980" Height="680" MinWidth="760" MinHeight="560"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid Margin="20,16,8,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,12,8">
            <Button DockPanel.Dock="Right" Command="{Binding ToggleServerCommand}" Content="{Binding ServerButtonText}"
                    Background="#3B6FC4" Padding="18,7" Margin="0"/>
            <StackPanel>
                <TextBlock Text="Phone2Gamepad" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource Caption}">
                    <Run Text="Server: "/><Run Text="{Binding ServerState, Mode=OneWay}"/>
                    <Run Text="   Virtual controller: "/><Run Text="{Binding DriverKind, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Background="#3A2A2A" BorderBrush="{StaticResource Bad}" Margin="0,0,12,8"
                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Grid.Row="2">
            <!-- ===================== Dashboard ===================== -->
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,0,12">
                        <WrapPanel>
                            <Border Style="{StaticResource CardBorder}" Width="430">
                                <StackPanel>
                                    <TextBlock Text="Phone" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding PhoneName}" Style="{StaticResource Value}"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Transport" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Transport}"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Uptime" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Uptime}"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Round-trip latency" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Latency}"/></StackPanel>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Packet rate" Style="{StaticResource Caption}"/><TextBlock Text="{Binding PacketRate}"/></StackPanel>
                                        <StackPanel Grid.Column="1"><TextBlock Text="Received" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Received}"/></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Invalid" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Invalid}"/></StackPanel>
                                        <StackPanel Grid.Column="3"><TextBlock Text="Dropped (dup/old)" Style="{StaticResource Caption}"/><TextBlock Text="{Binding Dropped}"/></StackPanel>
                                    </Grid>
                                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Caption}">
                                        <Run Text="Input: "/><Run Text="{Binding InputState, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Width="430">
                                <StackPanel>
                                    <TextBlock Text="Pairing" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding PinText}" FontSize="34" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,2,0,2"/>
                                    <TextBlock Text="{Binding PairingStatus}" TextWrapping="Wrap" Style="{StaticResource Caption}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Open pairing" Command="{Binding OpenPairingCommand}"/>
                                        <Button Content="Close" Command="{Binding ClosePairingCommand}"/>
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}" TextWrapping="Wrap"
                                               Text="A QR code is not available yet: enter the PIN manually on the phone."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Width="430">
                                <StackPanel>
                                    <TextBlock Text="Network" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding ListenText}" Style="{StaticResource Value}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding PortsText}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Text="Local network only: connections from outside private address ranges are refused. If the phone cannot connect, allow Phone2Gamepad through Windows Firewall (Private networks)."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Width="430">
                                <StackPanel>
                                    <TextBlock Text="Virtual controller driver" Style="{StaticResource Caption}"/>
                                    <TextBlock Text="{Binding DriverKind}" Style="{StaticResource Value}"/>
                                    <TextBlock Text="{Binding DriverStatus}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding DriverHelp}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                                    <Button Content="Retry" Command="{Binding RetryDriverCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="{Binding DriverNeedsHelp, Converter={StaticResource BoolVis}}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Controller test ===================== -->
            <TabItem Header="Controller test">
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <local:ControllerVisual State="{Binding LiveState}"/>
                    </Border>
                    <TextBlock Grid.Row="1" TextWrapping="Wrap" Style="{StaticResource Caption}">
                        This shows the state that is sent to the virtual controller (after mapping). To verify what Windows sees, press Win+R, run
                        <Run FontFamily="Consolas" Text="joy.cpl"/>, select "Controller (XBOX 360 For Windows)" and open Properties. Then try a game that supports XInput controllers.
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- ===================== Mapping ===================== -->
            <TabItem Header="Mapping">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,12">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Profile" Style="{StaticResource Caption}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <ComboBox Width="200" ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile}" Margin="0,0,10,0"/>
                                    <Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}"/>
                                    <Button Content="Delete" Command="{Binding DeleteProfileCommand}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBox Width="200" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                                    <Button Content="Save as new profile" Command="{Binding SaveProfileCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MappingMessage}" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel>
                            <Border Style="{StaticResource CardBorder}" Width="430">
                                <StackPanel>
                                    <TextBlock Text="Sticks" Style="{StaticResource Caption}"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding LeftDeadZone, StringFormat=Left dead zone: {0:P0}}"/>
                                    <Slider Minimum="0" Maximum="0.9" Value="{Binding LeftDeadZone}"/>
                                    <TextBlock Text="{Binding LeftSensitivity, StringFormat=Left sensitivity: {0:0.00}x}"/>
                                    <Slider Minimum="0.25" Maximum="4" Value="{Binding LeftSensitivity}"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding RightDeadZone, StringFormat=Right dead zone: {0:P0}}"/>
                                    <Slider Minimum="0" Maximum="0.9" Value="{Binding RightDeadZone}"/>
                                    <TextBlock Text="{Binding RightSensitivity, StringFormat=Right sensitivity: {0:0.00}x}"/>
                                    <Slider Minimum="0.25" Maximum="4" Value="{Binding RightSensitivity}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <CheckBox Content="Invert left X" IsChecked="{Binding InvertLeftX}" Margin="0,0,14,0"/>
                                        <CheckBox Content="Invert left Y" IsChecked="{Binding InvertLeftY}" Margin="0,0,14,0"/>
                                        <CheckBox Content="Invert right X" IsChecked="{Binding InvertRightX}" Margin="0,0,14,0"/>
                                        <CheckBox Content="Invert right Y" IsChecked="{Binding InvertRightY}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="430">
                                <StackPanel>
                                    <TextBlock Text="Triggers" Style="{StaticResource Caption}"/>
                                    <TextBlock Margin="0,6,0,0" Text="{Binding TriggerMin, StringFormat=Calibration - released at or below: {0:0}}"/>
                                    <Slider Minimum="0" Maximum="254" Value="{Binding TriggerMin}"/>
                                    <TextBlock Text="{Binding TriggerMax, StringFormat=Calibration - fully pressed at or above: {0:0}}"/>
                                    <Slider Minimum="1" Maximum="255" Value="{Binding TriggerMax}"/>
                                    <CheckBox Content="Left trigger digital (on/off)" IsChecked="{Binding LeftTriggerDigital}" Margin="0,8,0,0"/>
                                    <CheckBox Content="Right trigger digital (on/off)" IsChecked="{Binding RightTriggerDigital}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Width="430">
                                <StackPanel>
                                    <TextBlock Text="Button remapping (phone button -> Xbox button)" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding ButtonMap}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Column="1" SelectedItem="{Binding Target}"
                                                              ItemsSource="{Binding DataContext.TargetChoices, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===================== Paired devices ===================== -->
            <TabItem Header="Paired phones">
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Paired" Binding="{Binding PairedAt}" Width="180"/>
                            <DataGridTemplateColumn Header="" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Revoke" Margin="4,2"
                                                Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Revoking deletes the stored pairing key and ends that phone's session; it must be paired again with a new PIN."/>
                </Grid>
            </TabItem>

            <!-- ===================== Log ===================== -->
            <TabItem Header="Log">
                <Grid Margin="0,0,12,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogEntries}" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}"
                             FontFamily="Consolas" FontSize="12">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Export diagnostics..." Command="{Binding ExportDiagnosticsCommand}"/>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center"
                                   Text="Exports counters and recent log lines. PINs and keys are always removed; IP addresses and device ids/names are masked unless you tick the box in Settings."/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===================== Settings / About ===================== -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,12,12" MaxWidth="620" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource Caption}"/>
                                <CheckBox Content="Start the server when the app opens" IsChecked="{Binding StartServerOnLaunch}"/>
                                <CheckBox Content="Closing the window keeps the app running in the system tray" IsChecked="{Binding MinimizeToTrayOnClose}"/>
                                <CheckBox Content="Start with Windows (minimized to tray)" IsChecked="{Binding StartWithWindows}"/>
                                <TextBlock Text="Log level" Style="{StaticResource Caption}" Margin="0,10,0,2"/>
                                <ComboBox Width="160" HorizontalAlignment="Left" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}"/>
                                <TextBlock Text="Diagnostics" Style="{StaticResource Caption}" Margin="0,12,0,2"/>
                                <CheckBox Content="Include IP addresses and device ids/names in the export (off = masked)" IsChecked="{Binding IncludeNetworkDetails}"/>
                                <Button Content="Export diagnostics..." Command="{Binding ExportDiagnosticsCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Network (restart the server to apply)" Style="{StaticResource Caption}"/>
                                <TextBlock Text="PC name shown to phones" Margin="0,8,0,2"/>
                                <TextBox Text="{Binding ServerName, UpdateSourceTrigger=LostFocus}" Width="260" HorizontalAlignment="Left"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Control (TCP)" Style="{StaticResource Caption}"/><TextBox Text="{Binding ControlPort, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Input (UDP)" Style="{StaticResource Caption}"/><TextBox Text="{Binding InputPort, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Discovery (UDP)" Style="{StaticResource Caption}"/><TextBox Text="{Binding DiscoveryPort, UpdateSourceTrigger=LostFocus}"/></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="About" Style="{StaticResource Caption}"/>
                                <TextBlock Margin="0,4,0,0"><Run Text="Phone2Gamepad "/><Run Text="{Binding Version, Mode=OneWay}"/><Run Text="  -  protocol v1"/></TextBlock>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Works entirely on your local network. No accounts, no cloud, no telemetry. Not implemented yet: QR pairing, USB transport, vibration feedback, multiple phones."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
