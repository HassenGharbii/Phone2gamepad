<Application x:Class="Phone2Gamepad.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Phone2Gamepad.Windows">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Colour tokens first (swapped at runtime by ThemeService), then styles that reference them dynamically. -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:InverseBoolVisConverter x:Key="InverseBoolVis"/>
            <local:NotEmptyVisConverter x:Key="NotEmptyVis"/>
            <local:ToneBrushConverter x:Key="ToneFg"/>
            <local:ToneBrushConverter x:Key="ToneBg" Suffix="Bg"/>
            <local:ChecklistStateConverter x:Key="Checklist"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
