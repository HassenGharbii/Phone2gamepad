<Window x:Class="Phone2Gamepad.Windows.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Layer}" Foreground="{DynamicResource Fg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <StackPanel>
        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="Heading" Style="{StaticResource Subtitle}" Margin="0,0,0,12"/>
            <TextBlock x:Name="Message" Style="{StaticResource BodySecondary}"/>
        </StackPanel>
        <Border Background="{DynamicResource LayerAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,16">
            <UniformGrid Columns="2">
                <Button x:Name="Primary" Margin="0,0,8,0" Click="Primary_Click"/>
                <Button x:Name="Secondary" Margin="8,0,0,0" IsCancel="True"/>
            </UniformGrid>
        </Border>
    </StackPanel>
</Window>
