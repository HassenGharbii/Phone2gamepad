<UserControl x:Class="Phone2Gamepad.Windows.Views.PhonesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch">
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Command="{Binding OpenPairingCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Pair a phone"/></StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="Phones" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="Phones you've allowed to control this PC. Removing one deletes its key; it must pair again with a new PIN."
                               Style="{StaticResource BodySecondary}"/>
                </StackPanel>
            </DockPanel>

            <!-- empty state -->
            <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding NoPhones, Converter={StaticResource BoolVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource FgTertiary}"/>
                    <TextBlock Text="No phones paired yet" Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                    <TextBlock Text="Install Phone2Gamepad on your Android phone, then choose Pair a phone." Style="{StaticResource BodySecondary}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Phones}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SettingRow}" Padding="16,14" Margin="0,0,0,8">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource LayerAlt}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" FontSize="18" HorizontalAlignment="Center"/>
                                </Border>
                                <!-- actions -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolVis}}">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE70F;" Command="{Binding EditCommand}" ToolTip="Rename"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Rename {0}}" Margin="0,0,4,0"/>
                                    <Button Content="Remove" Command="{Binding RevokeCommand}"
                                            AutomationProperties.Name="{Binding DisplayName, StringFormat=Remove {0}}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}">
                                    <Button Content="Save" Style="{StaticResource AccentButton}" Command="{Binding SaveCommand}" IsDefault="{Binding IsEditing}" Margin="0,0,8,0"/>
                                    <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="{Binding IsEditing}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolVis}}">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                                        <Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessBg}" BorderThickness="0" Margin="10,0,0,0"
                                                Visibility="{Binding IsConnected, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="Connected" FontSize="12" Foreground="{DynamicResource Success}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" MaxWidth="320" HorizontalAlignment="Left"
                                             Visibility="{Binding IsEditing, Converter={StaticResource BoolVis}}" AutomationProperties.Name="Phone name"
                                             IsVisibleChanged="EditBox_IsVisibleChanged"/>
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Names you give phones are only stored on this PC." Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Visibility="{Binding HasPhones, Converter={StaticResource BoolVis}}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
