<Window x:Class="Phone2Gamepad.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone2Gamepad" Width="1100" Height="720" MinWidth="720" MinHeight="520"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Fg}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        WindowStartupLocation="Manual">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="0"/>
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="1"/>
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="2"/>
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="3"/>
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="4"/>
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="5"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============================== navigation rail -->
        <DockPanel Grid.Column="0" Margin="8,12,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,4,0,16" x:Name="Brand">
                <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Accent}">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" HorizontalAlignment="Center" Foreground="{DynamicResource OnAccent}"/>
                </Border>
                <TextBlock x:Name="BrandText" Text="Phone2Gamepad" Style="{StaticResource BodyStrong}" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- footer: server switch -->
            <Border DockPanel.Dock="Bottom" x:Name="ServerFooter" Style="{StaticResource Card}" Padding="12,10" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource FgTertiary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True"><Setter Property="Fill" Value="{DynamicResource Success}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding ServerStateText}" Style="{StaticResource BodyStrong}" x:Name="ServerText"/>
                    </StackPanel>
                    <Button Content="{Binding ServerToggleText}" Command="{Binding ToggleServerCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            AutomationProperties.Name="{Binding ServerToggleText}" x:Name="ServerButton"
                            ToolTip="Phones can only find and use this PC while the server is on."/>
                </StackPanel>
            </Border>

            <ListBox x:Name="Nav" Style="{StaticResource NavList}"
                     ItemsSource="{Binding Pages}" SelectedIndex="{Binding SelectedPage, Mode=TwoWay}"
                     AutomationProperties.Name="Navigation">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
                        <Setter Property="ToolTip" Value="{Binding Shortcut}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" Width="20"/>
                            <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" Tag="NavLabel"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ============================== content -->
        <Grid Grid.Column="1" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource InfoBarCritical}" Margin="16,0,16,8" Visibility="{Binding HasError, Converter={StaticResource BoolVis}}"
                    AutomationProperties.LiveSetting="Assertive">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding DismissErrorCommand}"
                            AutomationProperties.Name="Dismiss error" ToolTip="Dismiss" VerticalAlignment="Top"/>
                    <TextBlock Text="&#xEA39;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Critical}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <TextBlock Text="{Binding Error}" Style="{StaticResource Body}"/>
                </DockPanel>
            </Border>
            <ContentControl Grid.Row="1" x:Name="PageHost" Focusable="False"/>
        </Grid>
    </Grid>
</Window>
