<UserControl x:Class="Phone2Gamepad.Windows.Views.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Phone2Gamepad.Windows.Controls">
    <ScrollViewer Style="{StaticResource PageScroller}">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">
            <TextBlock Text="Controller" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="What Windows receives from your phone, after mapping. Use this to check every button, stick and trigger."
                       Style="{StaticResource BodySecondary}" Margin="0,0,0,16"/>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}">
                            <TextBlock Text="{Binding InputStateText}" Style="{StaticResource Caption}" Foreground="{DynamicResource FgSecondary}"/>
                        </Border>
                        <TextBlock Text="Virtual Xbox 360 controller" Style="{StaticResource BodyStrong}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <c:ControllerVisual State="{Binding LiveState}" IsLive="{Binding IsLive}" Height="380" Margin="0,8"
                                        AutomationProperties.Name="Live view of the virtual controller"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Raw values" Style="{StaticResource BodyStrong}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="3" x:Name="Values">
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="Left stick (x, y)" Style="{StaticResource Caption}"/><TextBlock Text="{Binding LeftStickText}" Style="{StaticResource MetricValue}" FontFamily="{StaticResource MonoFont}" FontSize="16"/></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="Right stick (x, y)" Style="{StaticResource Caption}"/><TextBlock Text="{Binding RightStickText}" Style="{StaticResource MetricValue}" FontFamily="{StaticResource MonoFont}" FontSize="16"/></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="Triggers (LT, RT)" Style="{StaticResource Caption}"/><TextBlock Text="{Binding TriggersText}" Style="{StaticResource MetricValue}" FontFamily="{StaticResource MonoFont}" FontSize="16"/></StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Pressed" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding PressedText}" Style="{StaticResource Body}" Margin="0,2,0,0"/>
                    <TextBlock Text="Sticks range from −32768 to 32767 (up is positive); triggers from 0 to 255." Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" VerticalAlignment="Center" Command="{Binding OpenJoyCplCommand}" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="Open Game Controllers"/></StackPanel>
                    </Button>
                    <StackPanel>
                        <TextBlock Text="Check it in Windows" Style="{StaticResource BodyStrong}"/>
                        <TextBlock Style="{StaticResource BodySecondary}" FontSize="13" Margin="0,4,0,0"
                                   Text="Open Game Controllers, select “Controller (Xbox 360 for Windows)” and choose Properties to see the same input. Then try any game that supports Xbox controllers."/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
