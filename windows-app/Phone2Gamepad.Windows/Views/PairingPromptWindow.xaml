<Window x:Class="Phone2Gamepad.Windows.Views.PairingPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Allow this phone?" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Layer}" Foreground="{DynamicResource Fg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <StackPanel>
        <DockPanel Margin="24,22,24,8">
            <Border DockPanel.Dock="Left" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSubtle}" Margin="0,0,16,0" VerticalAlignment="Top">
                <TextBlock Text="&#xE8EA;" Style="{StaticResource Glyph}" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource AccentText}"/>
            </Border>
            <StackPanel>
                <TextBlock Text="Allow this phone to control your PC?" Style="{StaticResource Subtitle}"/>
                <TextBlock Style="{StaticResource BodySecondary}" Margin="0,6,0,0"
                           Text="It entered the correct PIN. Once allowed, it can act as a game controller on this PC — nothing else."/>
            </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Tile}" Margin="88,8,24,8" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="PhoneName" Style="{StaticResource BodyStrong}" FontSize="16"/>
                <TextBlock x:Name="PhoneIp" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
        <TextBlock Margin="88,4,24,20" Style="{StaticResource Caption}" Text="Only allow phones you recognise. If you didn't just enter a PIN on your phone, choose Don't allow."/>
        <Border Background="{DynamicResource LayerAlt}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="24,16">
            <UniformGrid Columns="2">
                <Button x:Name="AllowButton" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="Allow_Click" AutomationProperties.Name="Allow">
                    <AccessText Text="_Allow"/>
                </Button>
                <Button x:Name="DenyButton" Margin="8,0,0,0" IsCancel="True" Click="Deny_Click" AutomationProperties.Name="Don't allow">
                    <AccessText Text="_Don't allow"/>
                </Button>
            </UniformGrid>
        </Border>
    </StackPanel>
</Window>
